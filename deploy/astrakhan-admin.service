# Копировать в /etc/systemd/system/astrakhan-admin.service
# После правки: sudo systemctl daemon-reload && sudo systemctl enable astrakhan-admin && sudo systemctl start astrakhan-admin
# Путь к JAR и WorkingDirectory заменить на свой APP_DIR (например /opt/astramicro)

[Unit]
Description=Astrakhan Admin (Spring Boot)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/astramicro/astrakhan-admin
# Секреты: /etc/astrakhan-admin.env (почта и т.д.) и/или единый /etc/astra/admin.env (DGIS_MAP_KEY, SPRING_* …)
EnvironmentFile=-/etc/astrakhan-admin.env
EnvironmentFile=-/etc/astra/admin.env
ExecStart=/usr/bin/java -Xmx1024m -Dspring.profiles.active=prod -jar /opt/astramicro/astrakhan-admin/target/history-admin-1.0.0.jar
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
