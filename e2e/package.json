{
  "name": "astra-e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:update": "playwright test --update-snapshots",
    "test:ui": "playwright test --ui",
    "test:module2": "playwright test module2",
    "test:update:module2": "playwright test module2 --update-snapshots",
    "test:admin": "playwright test astrakhan-admin --workers=1",
    "test:admin:screenshots": "playwright test astrakhan-admin/screenshots.spec.ts",
    "test:admin:functional": "playwright test astrakhan-admin/functional.spec.ts",
    "test:admin:kos-screenshots": "playwright test astrakhan-admin/kos-test-screenshots.spec.ts --workers=1",
    "test:update:admin": "playwright test astrakhan-admin --update-snapshots",
    "copy:admin-diploma": "node astrakhan-admin/scripts/copy-diploma-screenshots.mjs",
    "copy:kos-test-screenshots": "node astrakhan-admin/scripts/copy-kos-test-screenshots.mjs",
    "test:module3": "playwright test module3",
    "install:browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
